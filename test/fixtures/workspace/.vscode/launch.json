{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "fixture with secrets",
      "program": "${workspaceFolder}/app.js",
      "env": {
        "LOG_LEVEL": "debug"
      },
      "externalSecrets": {
        "provider": "aws-sm",
        "profile": "fixture",
        "region": "us-east-1",
        "env": {
          "DB_PASSWORD": { "key": "fixture/db", "property": "password" }
        }
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "fixture without secrets",
      "program": "${workspaceFolder}/app.js"
    }
  ]
}
